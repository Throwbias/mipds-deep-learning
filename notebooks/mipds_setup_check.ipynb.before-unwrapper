    "      \"metadata\": {},\n",
    "      \"source\": [\n",
    "        \"checks[\\\"GPU computation\\\"] = False\\n\",\n",
    "        \"gpus = tf.config.list_physical_devices(\\\"GPU\\\")\\n\",\n",
    "        \"print(\\\"Available GPUs:\\\", gpus)\\n\",\n",
    "        \"if not gpus:\\n\",\n",
    "        \"    raise RuntimeError(\\\"No GPU is visible to this notebook. Share this cell's output.\\\")\\n\",\n",
    "        \"\\n\",\n",
    "        \"try:\\n\",\n",
    "        \"    for gpu in gpus:\\n\",\n",
    "        \"        if not tf.config.experimental.get_memory_growth(gpu):\\n\",\n",
    "        \"            tf.config.experimental.set_memory_growth(gpu, True)\\n\",\n",
    "        \"except RuntimeError as error:\\n\",\n",
    "        \"    raise RuntimeError(\\\"Restart the notebook kernel, then choose Run All.\\\") from error\\n\",\n",
    "        \"\\n\",\n",
    "        \"gpu_name = tf.config.experimental.get_device_details(gpus[0]).get(\\n\",\n",
    "        \"    \\\"device_name\\\", gpus[0].name\\n\",\n",
    "        \")\\n\",\n",
    "        \"print(\\\"GPU name:\\\", gpu_name)\\n\",\n",
    "        \"\\n\",\n",
    "        \"previous_soft_placement = tf.config.get_soft_device_placement()\\n\",\n",
    "        \"try:\\n\",\n",
    "        \"    tf.config.set_soft_device_placement(False)\\n\",\n",
    "        \"    with tf.device(\\\"/GPU:0\\\"):\\n\",\n",
    "        \"        matrix_result = tf.matmul(\\n\",\n",
    "        \"            tf.constant([[1.0, 2.0]]), tf.constant([[3.0], [4.0]])\\n\",\n",
    "        \"        )\\n\",\n",
    "        \"        convolution_result = tf.nn.conv2d(\\n\",\n",
